# dependencies
/node_modules

# next.js
/.next/
/out/

# build artifacts
/build
/coverage

# rendered-geometry crawler output (scripts/qa-crawl.mjs)
/.qa-crawl/

# local data
/.submissions/

# environment
.env*
.vercel

# system
.DS_Store
*.pem

# source media + working files (not part of the deployed site)
Website  Contents  /

# Claude config: ignore the installed-skills cache (hundreds of vendored JS files),
# but DO track the QA agent definitions — they are project source and CI depends on them.
.claude/*
!.claude/agents/
!.claude/launch.json

# raw image formats (keep only optimized versions in public/)
*.tif
*.tiff
*.psd

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# typescript
*.tsbuildinfo
